page { height: 100%; overflow: hidden; }
.chat-screen { display: flex; flex-direction: column; overflow: hidden; background: transparent; position: relative; }
.chat-screen button { margin: 0; padding: 0; line-height: inherit; border: 0; border-radius: 0; font-weight: 400; }
.chat-screen button::after { border: 0; }
.chat-screen button[disabled] { opacity: .42; }
.chat-screen .chat-text-button { display: inline-flex; align-items: center; background: transparent; color: #7D6B8C; font-size: 24rpx; gap: 4rpx; min-height: 88rpx; }
.chat-error { margin: 0 30rpx 16rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; }
.chat-profile-strip { display: flex; align-items: center; margin: 16rpx 32rpx 8rpx; padding: 24rpx 28rpx; background: rgba(255,255,255,.76); border: 1rpx solid rgba(129,114,143,.1); border-radius: 32rpx; flex-shrink: 0; }
.profile-strip-main { flex: 1; min-width: 0; }
.profile-strip-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 26rpx; font-weight: 500; color: #65516F; }
.profile-strip-count { flex-shrink: 0; padding: 2rpx 14rpx; border-radius: 999rpx; background: #F3F0F8; font-size: 22rpx; font-weight: 400; color: #7D6B8C; }
.profile-progress { height: 8rpx; background: #ECE7F2; border-radius: 8rpx; margin-top: 18rpx; overflow: hidden; }
.profile-progress-fill { height: 100%; border-radius: inherit; background: #A99ABC; transition: width .3s ease; }
.message-scroll, .consent-scroll { flex: 1; height: 0; min-height: 0; }
.consent-scroll { display: flex; flex-direction: column; }
.message-content { padding: 0 32rpx; }
.chat-date { display: flex; align-items: center; justify-content: center; gap: 20rpx; color: #776383; font-size: 22rpx; padding: 28rpx 24rpx 36rpx; }
.chat-date-rule { width: 56rpx; height: 1rpx; background: rgba(129,114,143,.16); }
.message-group { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 32rpx; }
.message-main { min-width: 0; max-width: calc(100% - 74rpx); }
.message-bubble { padding: 24rpx 28rpx; min-height: 88rpx; font-size: 30rpx; line-height: 1.65; color: #62536F; word-break: break-word; white-space: pre-wrap; box-sizing: border-box; }
.companion-message { background: rgba(255,255,255,.88); border: 1rpx solid rgba(129,114,143,.1); border-radius: 32rpx; }
.user-message { background: #EBE5F4; border: 1rpx solid #DED5E9; border-radius: 32rpx; color: #65516F; }
.voice-bubble { padding: 12rpx 24rpx; }
.from-user { justify-content: flex-end; }
.from-user .message-main { display: flex; flex-direction: column; align-items: flex-end; max-width: 80%; }
.companion-orb { position: relative; width: 58rpx; height: 58rpx; border-radius: 50%; flex-shrink: 0; margin-top: 4rpx; overflow: hidden; border: 3rpx solid #FFFFFFE6; background: radial-gradient(circle at 31% 24%,#FAFAFFDD 0,transparent 35%),radial-gradient(ellipse at 65% 71%,#F4DDEE,transparent 57%),linear-gradient(145deg,#B9C4EE,#DED4F4 55%,#BAC9EE); box-shadow: 0 4rpx 14rpx #B6A0CE22,inset 0 0 9rpx #FFF; }
.companion-orb::before { content: ''; position: absolute; width: 115%; height: 14rpx; background: #FFFFFFAA; top: 49%; left: -10%; transform: rotate(-24deg); filter: blur(3rpx); }
.orb-spark { position: absolute; width: 9rpx; height: 9rpx; top: 21rpx; left: 17rpx; background: #FFFFFFDD; transform: rotate(45deg); box-shadow: 19rpx 5rpx 7rpx #FFFFFFDD; }
.chat-user-avatar { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 50%; margin-top: 4rpx; background: #F3EFF8; border: 1rpx solid #DED5E9; color: #9681A7; flex-shrink: 0; }
.message-saved, .voice-answer-note { display: block; color: #776383; font-size: 22rpx; margin-top: 10rpx; line-height: 1.6; }
.guide-skip-row { margin: 0 0 0 74rpx; display: flex; align-items: center; }
.chat-screen .guide-skip-button { font-size: 24rpx; color: #7D6B8C; padding: 12rpx 28rpx; border-radius: 999rpx; border: 1rpx solid #C7C1D2; background: rgba(255,255,255,.64); }
.scroll-tail { height: 28rpx; }
.input-dock { flex-shrink: 0; background: transparent; padding: 16rpx 32rpx max(16rpx, env(safe-area-inset-bottom)); }
.input-row { display: flex; gap: 12rpx; align-items: center; padding: 10rpx; border-radius: 56rpx; background: rgba(255,255,255,.9); border: 1rpx solid #D7CFDF; }
.chat-screen .mode-button { width: 88rpx; height: 88rpx; border-radius: 50%; color: #7D6B8C; background: transparent; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.chat-input { flex: 1; min-width: 0; width: auto; min-height: 48rpx; max-height: 176rpx; padding: 8rpx 0; background: transparent; color: #65516F; font-size: 30rpx; line-height: 44rpx; }
.chat-screen .send-button { flex-shrink: 0; display: flex; justify-content: center; align-items: center; width: 88rpx; height: 88rpx; border-radius: 50%; border: 1rpx solid #C7C1D2; color: #65516F; background: linear-gradient(115deg,#FBFAFF,#F3F0FA); }
.chat-screen .send-button[disabled] { background: #F1EEF5; border-color: transparent; color: #B9AFC5; opacity: 1; }
.chat-screen .hold-to-talk { flex: 1; min-width: 0; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; color: #7D6B8C; background: #F3F0FA; font-size: 28rpx; user-select: none; touch-action: none; -webkit-touch-callout: none; }
.chat-screen .hold-to-talk.is-recording { background: #E8DDF3; color: #79628D; }
.chat-screen .hold-to-talk.is-canceling { background: #F4E5EC; color: #A77189; }
.recording-indicator { position: absolute; z-index: 10; bottom: 220rpx; left: 12%; width: 76%; padding: 36rpx 24rpx; border-radius: 36rpx; background: rgba(255,255,255,.96); border: 1rpx solid #DED5E9; box-shadow: 0 12rpx 40rpx rgba(129,114,143,.08); text-align: center; color: #7D6B8C; font-size: 24rpx; pointer-events: none; }
.recording-duration { display: block; font-size: 28rpx; color: #7E6597; margin: 18rpx 0 10rpx; }
.recording-wave { display: flex; justify-content: center; align-items: center; gap: 9rpx; height: 54rpx; }
.recording-wave > view { width: 7rpx; height: 28rpx; border-radius: 8rpx; background: #B29BC9; animation: chat-wave .8s ease-in-out infinite alternate; }
.recording-wave > view:nth-child(2n) { height: 48rpx; animation-delay: -.3s; }
.recording-wave > view:nth-child(3n) { height: 36rpx; animation-delay: -.6s; }
.cancel-indicator { background: #FFF8FBF5; color: #B07B92; }
.cancel-indicator .recording-wave > view { background: #CA9DB3; }
.chat-screen .voice-message { display: flex; align-items: center; gap: 16rpx; background: transparent; color: inherit; font-size: 28rpx; min-width: 185rpx; min-height: 88rpx; }
.voice-wave { display: flex; align-items: center; gap: 5rpx; height: 34rpx; }
.voice-wave > view { height: 12rpx; width: 4rpx; border-radius: 4rpx; background: currentColor; opacity: .5; }
.voice-wave > view:nth-child(2n) { height: 27rpx; }
.voice-wave > view:nth-child(3n) { height: 19rpx; }
.is-playing .voice-wave > view { animation: chat-wave .65s ease-in-out infinite alternate; }
.is-playing .voice-wave > view:nth-child(2n) { animation-delay: -.35s; }
.audio-review { padding: 16rpx 24rpx 24rpx; border: 1rpx solid #D7CFDF; border-radius: 32rpx; background: rgba(255,255,255,.9); }
.audio-review-title { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; color: #65516F; font-size: 26rpx; }
.audio-review-row { display: flex; gap: 16rpx; align-items: center; margin: 8rpx 0 16rpx; }
.chat-screen .review-play { flex: 1; min-width: 0; border-radius: 999rpx; border: 1rpx solid #DED5E9; background: #F3F0FA; padding: 12rpx 20rpx; color: #7D6B8C; }
.chat-screen .chat-primary { display: flex; align-items: center; justify-content: center; background: linear-gradient(120deg,#B29ACC,#9482B4); color: #FFF; border-radius: 50rpx; font-size: 27rpx; min-height: 88rpx; padding: 20rpx 32rpx; }
.chat-screen .audio-send { flex-shrink: 0; min-height: 88rpx; font-size: 26rpx; padding: 16rpx 24rpx; border: 1rpx solid #C7C1D2; border-radius: 999rpx; background: linear-gradient(115deg,#FBFAFF,#F3F0FA); color: #65516F; }
.audio-review-note { font-size: 22rpx; line-height: 1.65; color: #776383; display: block; }
.chat-screen .chat-control-pressed { background: #EAE3F3; border-color: #B2A6C3; }
.consent-content { display: flex; flex-direction: column; justify-content: center; width: 100%; min-height: 100%; padding: 48rpx 40rpx 96rpx; }
.consent-welcome { display: flex; flex-direction: column; align-items: flex-start; flex-shrink: 0; padding: 52rpx 48rpx; border-radius: 36rpx; background: rgba(255,255,255,.7); }
.consent-heading { margin-top: 44rpx; color: #65516F; }
.consent-greeting, .consent-title { display: block; font-size: 48rpx; font-weight: 500; line-height: 1.5; letter-spacing: -1.2rpx; }
.consent-visual { flex-shrink: 0; }
.consent-orb { width: 132rpx; height: 132rpx; margin: 0; border-width: 3rpx; box-shadow: inset 0 0 18rpx #FFF, 0 20rpx 48rpx rgba(129,114,143,.06); }
.consent-orb::before { height: 22rpx; filter: blur(4rpx); }
.consent-orb .orb-spark { top: 44rpx; left: 36rpx; width: 14rpx; height: 14rpx; box-shadow: none; }
.chat-screen .accept-consent { flex-shrink: 0; width: 100%; min-height: 100rpx; margin-top: 60rpx; padding: 26rpx 36rpx; justify-content: space-between; border: 2rpx solid #C7C1D2; border-radius: 999rpx; background: linear-gradient(115deg, #FBFAFF, #F3F0FA); color: #65516F; font-size: 32rpx; font-weight: 500; transition: border-color .16s ease; }
.consent-arrow { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36rpx; height: 36rpx; }
.consent-arrow > view { position: relative; width: 32rpx; height: 2rpx; background: currentColor; }
.consent-arrow > view::after { content: ''; position: absolute; right: 0; top: -6rpx; width: 14rpx; height: 14rpx; border-right: 2rpx solid currentColor; border-top: 2rpx solid currentColor; transform: rotate(45deg); }
.chat-screen .consent-button-pressed { background: linear-gradient(115deg, #F3F0FA, #E8E2F2); border-color: #B2A6C3; }
@keyframes chat-wave { to { transform: scaleY(.45); opacity: .5; } }
@media (prefers-reduced-motion: reduce) { .recording-wave > view, .is-playing .voice-wave > view { animation: none; } .profile-progress-fill, .chat-screen .accept-consent { transition: none; } }

/* ================= 液态玻璃（参考 iMessage 液态玻璃气泡） =================
   做法：很薄的一层透明底 + 背景模糊增色；玻璃的厚边、高光、底部聚光是一张用代码渲染的九宫格贴图（border-image），
   小程序和网页都能用。页面背景不改。 */
.message-bubble, .chat-profile-strip, .chat-input, .chat-screen .hold-to-talk, .chat-screen .mode-button, .chat-screen .send-button, .chat-user-avatar, .audio-review, .chat-screen .guide-skip-button {
  position: relative; overflow: hidden; border: 0 !important;
  -webkit-backdrop-filter: blur(14px) saturate(185%) brightness(1.04); backdrop-filter: blur(14px) saturate(185%) brightness(1.04);
  background: linear-gradient(170deg, rgba(255,255,255,.22) 0%, rgba(255,255,255,.08) 55%, rgba(236,226,252,.16) 100%);
  box-shadow: 0 14rpx 30rpx -6rpx rgba(96,74,128,.22), 0 3rpx 8rpx rgba(96,74,128,.10);
  --glass-r: 46rpx;
}
.message-bubble::before, .chat-profile-strip::before, .chat-input-wrap::before, .chat-screen .hold-to-talk::before, .chat-screen .mode-button::before, .chat-screen .send-button::before, .chat-user-avatar::before, .audio-review::before, .chat-screen .guide-skip-button::before {
  content: ''; position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; box-sizing: border-box; z-index: 1;
  border-style: solid; border-color: transparent; border-width: var(--glass-r);
  border-image: url("data:image/png;base64,") 100 fill stretch;
}
.message-bubble::after, .chat-input-wrap::after, .chat-profile-strip::after, .chat-screen .hold-to-talk::after, .chat-screen .send-button::after, .chat-screen .mode-button::after { content: none; }
.chat-input-wrap { position: relative; border-radius: 48rpx; --glass-r: 48rpx; }
.message-bubble { border-radius: 46rpx; padding: 26rpx 36rpx; color: #4E3F60; }
.user-message {
  border-radius: 46rpx; color: #4A3A5E;
  background: linear-gradient(170deg, rgba(222,206,250,.42) 0%, rgba(198,178,240,.26) 55%, rgba(186,164,236,.34) 100%);
}
.voice-bubble { padding: 10rpx 30rpx; border-radius: 999rpx; }
.chat-profile-strip { border-radius: 40rpx; --glass-r: 40rpx; }
.profile-strip-count { background: rgba(255,255,255,.35); box-shadow: inset 1rpx 1rpx 0 rgba(255,255,255,.9); }
.profile-progress { background: rgba(255,255,255,.35); box-shadow: inset 0 1rpx 3rpx rgba(129,114,143,.18); }
.profile-progress-fill { background: linear-gradient(90deg, #C9B8E4, #A792C8); box-shadow: 0 0 10rpx rgba(167,146,200,.5); }
.chat-user-avatar { border-radius: 50%; color: #7E6994; }
/* 输入区：圆形按钮 + 胶囊输入框，各自是一块玻璃 */
.input-row { background: transparent; border: 0; padding: 0; gap: 16rpx; }
.chat-screen .mode-button, .chat-screen .send-button { width: 96rpx; height: 96rpx; border-radius: 50%; color: #5E4C74; --glass-r: 48rpx; }
.chat-screen .send-button { background: linear-gradient(170deg, rgba(214,196,250,.5), rgba(178,154,230,.36)); }
.chat-screen .send-button[disabled] { color: #A99CBB; }
.chat-input { min-height: 96rpx; padding: 26rpx 34rpx; border-radius: 48rpx; line-height: 44rpx; box-sizing: border-box; --glass-r: 48rpx; color: #4E3F60; }
.chat-screen .hold-to-talk { height: 96rpx; border-radius: 999rpx; color: #5E4C74; --glass-r: 48rpx; }
.chat-screen .hold-to-talk.is-recording { background: linear-gradient(170deg, rgba(214,196,250,.5), rgba(178,154,230,.36)); }
.chat-screen .hold-to-talk.is-canceling { background: linear-gradient(170deg, rgba(250,214,230,.5), rgba(232,176,204,.36)); }
.audio-review { border-radius: 40rpx; --glass-r: 40rpx; }
.chat-screen .guide-skip-button { border-radius: 999rpx; --glass-r: 30rpx; }
.chat-screen .chat-control-pressed { transform: scale(.94); transition: transform .12s ease; }
.recording-indicator { -webkit-backdrop-filter: blur(18px) saturate(185%); backdrop-filter: blur(18px) saturate(185%); background: rgba(255,255,255,.22); border: 1rpx solid rgba(255,255,255,.7); box-shadow: inset 2rpx 2rpx 0 rgba(255,255,255,.9), 0 16rpx 44rpx rgba(96,74,128,.2); }
/* 新消息：从下方轻轻浮上来，带一点弹性 */
.message-group { animation: glass-in .42s cubic-bezier(.3,1.35,.5,1) both; }
@keyframes glass-in { from { opacity: 0; transform: translateY(24rpx) scale(.96); } }
@media (prefers-reduced-motion: reduce) { .message-group { animation: none; } }
/* 输入框是原生组件，不能挂贴图伪元素，用内阴影画同样的厚边 */
.chat-input {
  box-shadow: inset 0 3rpx 1rpx rgba(255,255,255,.95), inset 0 14rpx 18rpx -10rpx rgba(255,255,255,.8), inset 0 -4rpx 2rpx rgba(255,255,255,.55),
    inset 0 -18rpx 22rpx -14rpx rgba(255,252,255,.6), inset 0 -3rpx 10rpx rgba(112,92,140,.18), 0 14rpx 30rpx -6rpx rgba(96,74,128,.22), 0 3rpx 8rpx rgba(96,74,128,.10);
}
/* ================= 版式：左右留白，气泡不顶满，上下有呼吸感（参考液态气泡聊天） ================= */
.message-content { padding: 0 30rpx; }
.message-group { gap: 18rpx; margin-bottom: 26rpx; align-items: flex-start; }
.from-companion { padding-right: 14%; }
.from-user { justify-content: flex-end; padding-left: 14%; }
.message-main { position: relative; max-width: 100%; }
.from-user .message-main { max-width: 100%; }
.message-bubble { padding: 22rpx 34rpx; min-height: 84rpx; border-radius: 44rpx; line-height: 1.6; }
.companion-orb, .chat-user-avatar { width: 64rpx; height: 64rpx; margin-top: 10rpx; }
.message-saved { margin-top: 8rpx; font-size: 21rpx; opacity: .8; }
.message-group.has-reaction { margin-bottom: 44rpx; }
/* 表情回应角标（双击 = ❤️） */
.reaction-badge { position: absolute; bottom: -24rpx; right: -6rpx; z-index: 3; min-width: 54rpx; height: 54rpx; padding: 0 10rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; border-radius: 27rpx; font-size: 30rpx; line-height: 1;
  background: rgba(255,255,255,.72); -webkit-backdrop-filter: blur(14px) saturate(170%); backdrop-filter: blur(14px) saturate(170%);
  box-shadow: inset 1rpx 1rpx 0 #FFF, 0 6rpx 16rpx rgba(96,74,128,.2); animation: reaction-pop .55s cubic-bezier(.3,1.7,.5,1) both; }
.from-user .reaction-badge { right: auto; left: -6rpx; }
.from-user .message-main .reaction-badge { bottom: 14rpx; }
@keyframes reaction-pop { 0% { transform: scale(0) rotate(-20deg); } 60% { transform: scale(1.3) rotate(6deg); } 100% { transform: scale(1); } }
/* 长按弹出的回应条 */
.reaction-picker { position: absolute; bottom: 100%; left: 0; z-index: 6; margin-bottom: 12rpx; display: flex; gap: 4rpx; padding: 10rpx 14rpx; border-radius: 999rpx; white-space: nowrap;
  background: rgba(255,255,255,.8); -webkit-backdrop-filter: blur(20px) saturate(170%); backdrop-filter: blur(20px) saturate(170%);
  box-shadow: inset 1rpx 1rpx 0 #FFF, 0 14rpx 34rpx rgba(96,74,128,.22); transform-origin: 18% 100%; animation: picker-in .32s cubic-bezier(.3,1.5,.5,1) both; }
.from-user .reaction-picker { left: auto; right: 0; transform-origin: 82% 100%; }
.reaction-choice { font-size: 46rpx; padding: 6rpx 8rpx; line-height: 1.1; }
@keyframes picker-in { from { opacity: 0; transform: scale(.4) translateY(20rpx); } }
/* 大表情贴纸：只发 1–3 个表情时，不要气泡，直接放大 */
.message-bubble.sticker-message { background: none !important; box-shadow: none !important; -webkit-backdrop-filter: none !important; backdrop-filter: none !important; padding: 0 6rpx !important; min-height: 0; font-size: 88rpx; line-height: 1.25; }
.message-bubble.sticker-message::before { content: none !important; }
/* 表情面板 */
.emoji-button .emoji-glyph { font-size: 44rpx; line-height: 1; }
.emoji-button.is-open { color: #9A84C2; }
.emoji-panel { margin: 0 24rpx 12rpx; display: flex; flex-wrap: wrap; padding: 14rpx 12rpx; border-radius: 40rpx; flex-shrink: 0;
  background: rgba(255,255,255,.6); -webkit-backdrop-filter: blur(20px) saturate(170%); backdrop-filter: blur(20px) saturate(170%);
  box-shadow: inset 1rpx 1rpx 0 #FFF, 0 12rpx 30rpx rgba(96,74,128,.16); animation: picker-in .3s cubic-bezier(.3,1.4,.5,1) both; transform-origin: 80% 100%; }
.emoji-item { width: 12.5%; text-align: center; font-size: 46rpx; line-height: 1.6; }
/* 间距再按参考图调：气泡更窄（两侧各留约 1/5），上下拉开，头像更大、贴近屏幕边 */
.message-content { padding: 0 22rpx; }
.message-group { gap: 16rpx; margin-bottom: 42rpx; }
.from-companion { padding-right: 22%; }
.from-user { padding-left: 22%; }
.companion-orb, .chat-user-avatar { width: 72rpx; height: 72rpx; margin-top: 6rpx; }
.message-bubble { padding: 24rpx 38rpx; min-height: 88rpx; border-radius: 46rpx; }
.message-group.has-reaction { margin-bottom: 58rpx; }
.message-saved { margin-top: 10rpx; }
/* ===== 按参考图逐项量过的版式（截图宽 1185px 换算成 750rpx） =====
   屏幕两边留 22rpx · 头像 76rpx、时间写在头像下面 · 头像到气泡 15rpx
   单行气泡高约 78rpx、完全胶囊 · 上下两条消息间隔 34rpx · 长文字气泡最宽约占屏幕 72%（另一侧空出约 10%） */
.message-content { padding: 0 22rpx; }
.message-group { gap: 15rpx; margin-bottom: 34rpx; align-items: flex-start; }
.from-companion { padding-right: 10%; }
.from-user { padding-left: 10%; }
.avatar-col { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; width: 76rpx; }
.avatar-col .companion-orb, .avatar-col .chat-user-avatar { width: 76rpx; height: 76rpx; margin-top: 0; }
.avatar-time { margin-top: 6rpx; font-size: 19rpx; line-height: 1.2; color: #8E7F9C; letter-spacing: .02em; white-space: nowrap; }
.message-main { padding-top: 0; }
.message-bubble { padding: 17rpx 32rpx; min-height: 78rpx; border-radius: 39rpx; font-size: 30rpx; line-height: 1.5; display: flex; align-items: center; }
.message-bubble text { display: block; }
.message-group.has-reaction { margin-bottom: 52rpx; }
.from-user .message-main .reaction-badge { bottom: -24rpx; }
.ma-dark .avatar-time { color: rgba(246,241,251,.55); }
/* ===== 二次精量（海边那张 1185px 宽，按 1px = 0.633rpx 换算） =====
   头像 120px→76rpx，离屏幕边 35px→22rpx · 气泡离头像 23px→15rpx
   气泡高 116px→74rpx，和头像一样高、顶部对齐，完全胶囊 · 气泡左右内边距 48px→30rpx · 字 48px→30rpx
   时间在头像正下方 7px→4rpx，字很小（约 21px→14rpx）
   每一行从上一行顶部到下一行顶部 172px→109rpx（头像 76 + 时间 ~20 + 行间 ~13） */
.message-content { padding: 0 22rpx; }
.message-group { gap: 15rpx; margin-bottom: 13rpx; align-items: flex-start; }
.avatar-col { width: 76rpx; }
.avatar-col .companion-orb, .avatar-col .chat-user-avatar { width: 76rpx; height: 76rpx; margin: 0; }
.avatar-time { margin-top: 4rpx; font-size: 15rpx; line-height: 20rpx; letter-spacing: .03em; }
.message-main { max-width: 500rpx; }
.from-companion, .from-user { padding-left: 0; padding-right: 0; }
.message-bubble { min-height: 74rpx; padding: 14rpx 30rpx; border-radius: 37rpx; font-size: 30rpx; line-height: 46rpx; }
.message-group.has-reaction { margin-bottom: 34rpx; }
/* 上下间隔：多行长气泡比头像高时，下一条会贴上来。给气泡下面固定留出一截，
   这样不管一行还是多行，气泡底到下一条顶都保持约 37rpx（参考图里约是气泡高的一半） */
.message-main { padding-bottom: 24rpx; }
.message-group { margin-bottom: 13rpx; }
/* 多行时字和框之间更透气（雪景那张），单行仍和头像一样高 */
.message-bubble { min-height: 76rpx; padding: 16rpx 32rpx; line-height: 44rpx; }
.message-group.has-reaction .message-main { padding-bottom: 40rpx; }
.message-group.has-reaction { margin-bottom: 13rpx; }
/* ===== 长句子气泡（雪景那张 1206px 宽，1px = 0.622rpx 精量） =====
   字 46px→29rpx，行距 66px→42rpx（约 1.45 倍）
   字到框：左右 45px→28rpx，上下 37px→23rpx · 圆角 55px→36rpx
   长气泡最宽占屏幕近八成，另一侧仍空出一截 → 有头像时最宽 540rpx */
.message-main { max-width: 540rpx; }
.message-bubble { font-size: 29rpx; line-height: 42rpx; padding: 21rpx 28rpx; border-radius: 36rpx; min-height: 76rpx; }
.voice-bubble { padding: 10rpx 28rpx; }
/* ===== 上下距离（雪景那张）：同一个人连发 29px→18rpx；换人说话 100px→56rpx =====
   同一个人连发时，只有第一条显示头像和时间，后面的留出同样宽度对齐（像 iMessage） */
.message-main { padding-bottom: 0; }
.message-group { margin-bottom: 0; margin-top: 56rpx; }
.message-group.same-prev { margin-top: 18rpx; }
.message-group.has-reaction { margin-bottom: 24rpx; }
/* 气泡到手机边：头像离边 22rpx（35px），气泡离头像 15rpx（23px）→ 气泡离边约 113rpx；
   另一侧长气泡最多到离边约 97rpx（雪景里长气泡另一侧空出约 17%） */
/* 对面要留出一大截：左边（AI）说话，气泡离右边框至少约 22%；右边（我）说话，气泡离左边框也一样。
   雪景那张：AI 气泡右侧空 35%，我的气泡左侧空 17% → 两边统一取约 22%（167rpx） */
.message-main, .from-user .message-main { max-width: 470rpx; }
