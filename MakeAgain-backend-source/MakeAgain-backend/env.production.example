# Make Again backend - production environment
# Copy to /opt/make-again/backend/.env and fill in real values

ENVIRONMENT=production
DATABASE_URL=sqlite:////app/data/b07.sqlite3
STORAGE_LOCAL_DIR=/app/uploads
PUBLIC_BASE_URL=https://makeagain.edsionc.top
CORS_ORIGINS=https://makeagain.edsionc.top

# All mocks must be false in production
MOCK_LLM=false
MOCK_WECHAT=false
MOCK_SPEECH=false
MOCK_VISION=false
MOCK_STORAGE=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MEDIA_SIGNING_KEY=d3feaaae3509373c64a2a52df7243cc0f0ccf03c3a794ef155a6e5ade0adc6f0

# LLM (fill in real key)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-chat
LLM_REPORT_MODEL=
LLM_TIMEOUT=60

# WeChat (fill in real values)
WECHAT_APPID=wx0872b60ff03a1adc
WECHAT_SECRET=51a2c32b7d55e1f27536e70c20b939d7
WECHAT_TIMEOUT=10

# TTS/ASR
